# Secrets and local configuration
# .env.example is the tracked template; the real file never leaves the machine.
.env
.env.*
!.env.example
.envrc
.direnv/
apps/web/.env
apps/web/.env.*
!apps/web/.env.example
secrets/
credentials/
private/
*.secret
*.credentials
*.token

# Private key material: ledger signing seeds, SSH keys, device certificates
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*

# Local runtime state. The ledger anchor file is evidence, not source; the
# default location is .zeronode/, but AUDIT_ANCHOR_FILE may point anywhere.
.zeronode/
*anchors*.jsonl
*.pid
*.sock
*.db
*.sqlite
*.sqlite3

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
junit*.xml
.hypothesis/
.tox/
.nox/
*.egg-info/
dist/
build/

# Node and Next.js
node_modules/
.next/
out/
*.tsbuildinfo

# Container and database runtime state. Schema and seed Cypher are tracked;
# everything Neo4j writes at runtime is not.
infra/neo4j/data/
infra/neo4j/logs/
infra/neo4j/import/
infra/neo4j/plugins/
infra/postgres/data/
infra/netbox/data/
infra/netbox/media/

# Network operating-system and packet-capture artifacts are licensed, large,
# or contain real traffic. Track topology/config text, never the images.
infra/containerlab/*.tar
infra/containerlab/*.tgz
infra/containerlab/*.qcow2
infra/containerlab/*.img
infra/containerlab/*.iso
infra/containerlab/*.bin
*.pcap
*.pcapng

# IaC state commonly contains rendered credentials.
*.tfstate
*.tfstate.*
.terraform/

# Editors and operating systems
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
.cursor/
*.swp
*.swo

# Local Compose customizations may contain host paths and credentials.
docker-compose.override.yml
compose.override.yml
