# Inference (Ollama on the host)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
# Token budget per turn. Too low and the model is cut off mid tool call.
OLLAMA_NUM_PREDICT=640

# OLLAMA_BASE_URL above is for running the API on the host.
# The Dockerised API reads OLLAMA_BASE_URL_DOCKER instead, so the two never clash.
# OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434

# Auth. Leave AUTH_ENABLED=true outside local experiments.
AUTH_ENABLED=true
# openssl rand -base64 48
JWT_SECRET=
JWT_TTL_MINUTES=60
# First admin, created on startup if the user table is empty.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-please-12chars
# Optional static token for alerting systems. Grants operator rights only:
# a machine credential can open an incident but can never approve a change.
SERVICE_TOKEN=
# Session cookies are httpOnly; set this once the dashboard is served over TLS.
COOKIE_SECURE=false
# Login throttling and account lockout.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_MINUTES=15
# Approvers must present a TOTP code. Turning this off makes an approval rest on
# a single stealable credential.
MFA_REQUIRED_FOR_APPROVERS=true

# Ed25519 seed signing the approval ledger. Without it records cannot be
# verified after a restart. Generate with:
#   cd apps/api && .venv/bin/python -m app.audit.keys generate
AUDIT_SIGNING_KEY=
# Public keys of retired signing keys, comma separated, so records signed before
# a rotation stay verifiable. Print both values with:
#   cd apps/api && .venv/bin/python -m app.audit.keys rotate
AUDIT_RETIRED_KEYS=
# Where the ledger head is anchored. Put it on a volume Postgres cannot write
# to; without it, deletion of the whole ledger leaves no trace.
AUDIT_ANCHOR_FILE=/var/lib/zeronode/anchors.jsonl

# Change windows. Empty means a change may be approved at any time. A freeze
# always beats a window, and only an admin can override either, with a reason
# that is sealed into the approval record.
#   CHANGE_WINDOWS=mon-fri 22:00-04:00; sat,sun 08:00-18:00
#   CHANGE_FREEZES=2026-12-20..2027-01-02; 2026-11-27
CHANGE_WINDOWS=
CHANGE_FREEZES=
CHANGE_WINDOW_TZ=UTC

# Secrets. Any credential above may name where it lives instead of holding the
# value: env:NAME, file:/run/secrets/name, vault:secret/data/zeronode#field or
# exec:some-command. Resolved values are cached for SECRET_CACHE_SECONDS, so
# rotating at the source takes effect without a restart.
SECRET_CACHE_SECONDS=300
# VAULT_ADDR=http://vault:8200
# VAULT_TOKEN=file:/run/secrets/vault_token
# Refuse to open an SSH session to a real device with an inline credential.
REQUIRE_MANAGED_SECRETS=true
# Refuse to start when Neo4j or Postgres is unreachable, rather than silently
# swapping in fixtures and in-memory state. Only turn this off locally.
STRICT_DEPENDENCIES=true

# Firewall backend: "mock" (fixtures), "cisco_asa" or "cisco_ios" (read-only SSH).
# The device backends need the devices extra: pip install -e "apps/api[devices]"
# Validate one before pointing the agent at it:
#   cd apps/api && .venv/bin/python -m app.firewall.probe --backend cisco_asa \
#       --host 192.0.2.10 --username readonly --flow 10.10.1.10,10.20.1.50,443
FIREWALL_BACKEND=mock
# FIREWALL_HOST=192.0.2.10
# FIREWALL_USERNAME=readonly
# A device password must come from a secret manager, not from this file.
# FIREWALL_PASSWORD=file:/run/secrets/asa_password
# Enable secret, only if show output needs privilege 15.
# FIREWALL_SECRET=file:/run/secrets/asa_enable
# FIREWALL_ACL=DMZ_TO_TRUST
# FIREWALL_DEVICE_ID=FW_Edge

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=zeronode

# Postgres (LangGraph checkpointer + incident index)
DATABASE_URL=postgresql://zeronode:zeronode@localhost:5433/zeronode

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
